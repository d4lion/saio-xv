# Entorno de Wompi: sandbox | production
VITE_WOMPI_ENV=sandbox

# Enlaces de Pago de Wompi Checkout para Boletas
VITE_WOMPI_LINK_GENERAL=https://checkout.wompi.co/l/tu_link_general
VITE_WOMPI_LINK_VIP=https://checkout.wompi.co/l/tu_link_vip
