# Configuración de Firebase
VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu_auth_domain_aqui
VITE_FIREBASE_PROJECT_ID=tu_project_id_aqui
VITE_FIREBASE_STORAGE_BUCKET=tu_storage_bucket_aqui
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id_aqui
VITE_FIREBASE_APP_ID=tu_app_id_aqui

# Entorno de Wompi: sandbox | production
VITE_WOMPI_ENV=sandbox

# Llave Privada de Wompi (Requerida por el servidor para consultar transacciones de forma segura)
# Nota: La llave privada NO lleva prefijo VITE_ porque se usa exclusivamente en el servidor backend.
WOMPI_PRIVATE_KEY=prv_prod_xxxxxxxxxxxxxxxxxxxxxxxx
# Opcional si usas llaves separadas para sandbox y produccion:
# WOMPI_PRIVATE_KEY_PROD=prv_prod_xxxxxxxxxxxxxxxxxxxxxxxx
# WOMPI_PRIVATE_KEY_SANDBOX=prv_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Enlaces de Pago de Wompi Checkout para Boletas
VITE_WOMPI_LINK_GENERAL=https://checkout.wompi.co/l/tu_link_general
VITE_WOMPI_LINK_VIP=https://checkout.wompi.co/l/tu_link_vip
